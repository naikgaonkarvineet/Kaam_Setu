# Supabase Client Configuration Example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# SMS Provider Reference (Configured in Supabase Dashboard > Authentication > Providers > Phone)
# Twilio Provider:
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_MESSAGE_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 
# MSG91 Provider (Alternative for Indian Numbers):
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=KMSETU
# MSG91_TEMPLATE_ID=your_dlt_template_id
